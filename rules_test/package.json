{
  "name": "watering-rules-test",
  "private": true,
  "type": "module",
  "description": "Firestore security rules tests (run on the local emulator, never touches the real project)",
  "scripts": {
    "test": "firebase emulators:exec --only firestore --project demo-watering --config ../firebase.rules-test.json \"node --test --test-concurrency=1\""
  },
  "devDependencies": {
    "@firebase/rules-unit-testing": "^3.0.4",
    "firebase": "^10.14.1"
  }
}
